parameters:
    level: 9
    paths:
        - src
        - backend
        - frontend
    bootstrapFiles:
        - vendor/autoload.php
        - ../../vendor/autoload.php
    treatPhpDocTypesAsCertain: false
    # tmpDir unik per repo, relatif agar portabel Windows/Linux. %env.TEMP% tidak
    # ada di runner Linux (CI gagal "Missing parameter 'env.TEMP'").
    tmpDir: .phpstan-cache
    parallel:
        maximumNumberOfProcesses: 1
