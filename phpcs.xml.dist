<?xml version="1.0"?>
<ruleset name="GDPlayer Default Theme">
    <description>
        Standar kode tema GDPlayer: PSR-12 (sama seperti proyek utama).
        Dipakai otomatis oleh `composer phpcs`; cakupannya disamakan dengan `phpstan.neon.dist`
        (frontend/views).
    </description>

    <file>frontend/views</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="p"/>

    <rule ref="PSR12"/>
</ruleset>
