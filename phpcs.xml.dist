<?xml version="1.0"?>
<ruleset name="GDPlayer Theme">
    <description>
        Standar kode GDPlayer (sama dengan root proyek): PSR-12. Dipakai otomatis oleh
        `composer phpcs` (phpcs mencari phpcs.xml/phpcs.xml.dist di root).
    </description>

    <file>src</file>
    <file>backend</file>
    <file>frontend</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/logs/*</exclude-pattern>
    <exclude-pattern>*/.phpunit.cache/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="p"/>

    <rule ref="PSR12"/>
</ruleset>
