{
	"name": "gdplayerto/gdplayer-theme",
	"description": "GDPlayer Theme",
	"version": "0.0.2",
	"type": "project",
	"homepage": "https://gdplayer.to",
	"license": "proprietary",
	"authors": [
		{
			"name": "GDPlayer Developer",
			"homepage": "https://github.com/gdplayerto",
			"email": "gdplayerdev@protonmail.com",
			"role": "Developer"
		}
	],
	"support": {
		"email": "gdplayerdev@protonmail.com",
		"telegram": "https://t.me/gdplayerto"
	},
	"funding": [
		{
			"type": "ko-fi",
			"url": "https://ko-fi.com/gdplayerdev"
		}
	],
	"minimum-stability": "stable",
	"prefer-stable": true,
	"require": {
		"php": ">=8.1.0",
		"ext-curl": "*",
		"ext-fileinfo": "*",
		"ext-filter": "*",
		"ext-hash": "*",
		"ext-gd": "*",
		"ext-json": "*",
		"ext-openssl": "*",
		"ext-pdo_mysql": "*",
		"ext-sockets": "*",
		"ext-sodium": "*",
		"ext-zip": "*"
	},
	"replace": {
		"symfony/polyfill-php80": "*",
		"symfony/polyfill-php81": "*",
		"symfony/polyfill-ctype": "*",
		"symfony/polyfill-intl": "*",
		"symfony/polyfill-mbstring": "*"
	},
	"suggest": {
		"ext-igbinary": "*",
		"ext-redis": "*",
		"ext-zstd": "*"
	},
	"autoload": {
		"psr-4": {
			"GDPlayer\\Theme\\Gdplayer\\": "src/"
		}
	},
	"config": {
		"process-timeout": 0,
		"platform-check": true,
		"optimize-autoloader": true,
		"classmap-authoritative": false
	},
	"scripts": {
		"post-install-cmd": [
			"composer dump-autoload -o"
		],
		"post-update-cmd": [
			"composer dump-autoload -o"
		],
		"sonar": "sonar-scanner",
		"php-cs-fixer": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --verbose",
		"phpcs": "phpcs src backend frontend > logs/phpcs_errors.log",
		"semgrep": "semgrep --config .semgrep/gdplayer.yml --metrics=off --error src backend frontend",
		"phpstan": "@php -d opcache.enable_cli=0 vendor/phpstan/phpstan/phpstan.phar analyse --level=8 --memory-limit 2G --no-progress > logs/phpstan_errors_lvl8.log",
		"check": [
			"@php -d opcache.enable_cli=0 vendor/phpstan/phpstan/phpstan.phar analyse --level=8 --memory-limit 2G --no-progress",
			"@php vendor/bin/phpcs",
			"@php vendor/bin/php-cs-fixer fix --dry-run --diff"
		],
		"dev": [
			"composer php-cs-fixer",
			"composer phpstan",
			"composer phpcs"
		]
	},
	"require-dev": {
		"phpstan/phpstan": "^2.3",
		"friendsofphp/php-cs-fixer": "^3.90",
		"squizlabs/php_codesniffer": "^4.0",
		"psr/http-message": "^2.0"
	}
}
