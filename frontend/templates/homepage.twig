{% include 'elements/header.twig' %}

<style>
@media (max-width: 991.98px) {
    .mock-player-container {
        max-width: 500px;
        margin: 20px auto 0 auto;
    }
    .mock-play-btn {
        width: 55px !important;
        height: 55px !important;
        font-size: 1.25rem !important;
        margin-bottom: 10px !important;
    }
    .mock-player-content .h5 {
        font-size: 0.95rem !important;
    }
    .mock-player-content p {
        font-size: 0.75rem !important;
    }
    .mock-controls {
        padding: 10px 15px !important;
    }
}
</style>

<!-- Hero Section -->
<section class="hero-section row" data-nosnippet>
    <div class="col-lg-6 mb-5 mb-lg-0 text-center text-lg-left">
        <h1 class="hero-title">{{ site_slogan|raw }}
        </h1>
        <p class="hero-subtitle my-4">{{ site_description|raw }}</p>
        <div class="d-flex flex-sm-row flex-column justify-content-center justify-content-lg-start">
            <a href="{{ current_url() }}#createVideoPlayer" class="btn btn-gradient mb-3 mb-sm-0 mr-sm-3">
                <i class="fas fa-play-circle mr-2"></i>Create Video Player</a>
			<a href="{{ current_url() }}#features" class="btn btn-outline-custom">
                <i class="fas fa-layer-group mr-2"></i>Explore Features</a>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="mock-player-container shadow-sm">
            <div class="mock-player-bg"></div>
            <div class="mock-player-content">
                <div class="mock-play-btn">
                    <i class="fas fa-play"></i>
                </div>
                <div class="h5 text-white mb-1">Demo_Video_1080p.mp4</div>
                <p class="text-muted small">Streaming seamlessly via GDPlayer Engine</p>
            </div>
            <div class="mock-controls">
                <span class="small text-muted">
                    <i class="fas fa-pause mr-3"></i> 02:14 / 12:40 </span>
                <span class="small text-muted">1080p <i class="fas fa-cog ml-2 mr-3"></i>
                    <i class="fas fa-expand"></i>
                </span>
            </div>
        </div>
    </div>
</section>

<!-- Stats Section -->
<div class="stats-bar text-center mb-5 shadow" data-nosnippet>
    <div class="row">
        <div class="col-12 col-md-3 mb-4 mb-md-0 stat-item">
            <div class="h3">45 <span>+</span></div>
            <p>Supported Video Hosts</p>
        </div>
        <div class="col-12 col-md-3 mb-4 mb-md-0 stat-item">
            <div class="h3">0 <span>%</span></div>
            <p>Buffering / Quota Limit</p>
        </div>
        <div class="col-12 col-md-3 mb-4 mb-md-0 stat-item">
            <div class="h3">100 <span>%</span></div>
            <p>Link Masking Protection</p>
        </div>
        <div class="col-12 col-md-3 mb-4 mb-md-0 stat-item">
            <div class="h3">Unlimited</div>
            <p>Unmetered Bandwidth Usage</p>
        </div>
    </div>
</div>

<!-- Player Section -->
<div id="createVideoPlayer" class="row mt-3">
	<div class="col-12">
		<div class="card mb-3 shadow-sm">
			<div class="h6 card-header">
				<i class="fas fa-film text-primary mr-2"></i> Player Configuration
			</div>
			<div class="card-body">
				{% include templates.player_form %}
			</div>
		</div>
		<div id="createPlayerResult" class="d-none card mb-3">
			<div class="h6 card-header">
				<i class="fas fa-play text-success mr-2"></i> Generated Output &amp; Preview
			</div>
			<div class="card-body">
				{% include templates.player_result %}
			</div>
		</div>
		{% include templates.link_examples %}
		{% include templates.disqus %}
	</div>
</div>

<!-- Features Section -->
<section id="features" class="text-center pt-5" data-nosnippet>
    <div class="text-center">
        <h2 class="section-title">Engineered For <span class="text-gradient">Scale and Profit</span></h2>
        <p class="section-subtitle">Everything you need to build a high-traffic, automated, and profitable video streaming network.</p>
    </div>
    <!-- Category 1: Playback -->
    <div class="mb-3">
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="feature-card playback">
                    <div class="icon-box">
                        <i class="fas fa-stream"></i>
                    </div>
                    <h3 class="h5">HLS & MPD Support</h3>
                    <p>Seamlessly play both static and live streaming HLS (m3u8) and MPD (dash) videos effortlessly.</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="feature-card playback">
                    <div class="icon-box">
                        <i class="fas fa-closed-captioning"></i>
                    </div>
                    <h3 class="h5">Multi-Subtitles</h3>
                    <p>Upload and display multiple subtitles (VTT/SRT formats) to cater to a global, diverse audience.</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="feature-card playback">
                    <div class="icon-box">
                        <i class="fas fa-photo-video"></i>
                    </div>
                    <h3 class="h5">Custom Players</h3>
                    <p>Fully supports world-class video engine interfaces including JW Player and Plyr layouts.</p>
                </div>
            </div>
        </div>
    </div>
    <!-- Category 2: Monetization -->
    <div class="mb-3">
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="feature-card monetize">
                    <div class="icon-box">
                        <i class="fas fa-ad"></i>
                    </div>
                    <h3 class="h5">Advanced VAST Ads</h3>
                    <p>Support for multiple VAST tags, overlay banners, and customizable popups for maximum yields.</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="feature-card monetize">
                    <div class="icon-box">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <h3 class="h5">Anti-Adblock Integration</h3>
                    <p>Built-in mechanics bypass regular ad-blockers, ensuring your video ads generate revenue.</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="feature-card monetize">
                    <div class="icon-box">
                        <i class="fas fa-link"></i>
                    </div>
                    <h3 class="h5">Link Shortener Support</h3>
                    <p>Easily monetize pre-roll sequences using major link shorteners such as AdFly and alternatives.</p>
                </div>
            </div>
        </div>
    </div>
    <!-- Category 3: Performance & Infrastructure -->
    <div class="mb-3">
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="feature-card infra">
                    <div class="icon-box">
                        <i class="fas fa-network-wired"></i>
                    </div>
                    <h3 class="h5">Load Balancer Ready</h3>
                    <p>Deploy across multiple load balancer servers smoothly without requiring additional scripts.</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="feature-card infra">
                    <div class="icon-box">
                        <i class="fas fa-bolt"></i>
                    </div>
                    <h3 class="h5">High-Velocity Caching</h3>
                    <p>Utilize , Memcached, Apcu, SQLite, or file-based caching systems to massively speed up query operations.</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="feature-card infra">
                    <div class="icon-box">
                        <i class="fas fa-sync-alt"></i>
                    </div>
                    <h3 class="h5">Smart Auto-Repair</h3>
                    <p>If a video streaming error is caught, the smart script auto-generates a brand new cache instantly.</p>
                </div>
            </div>
        </div>
    </div>
    <!-- Category 4: Security -->
    <div class="mb-3">
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="feature-card security">
                    <div class="icon-box">
                        <i class="fas fa-user-lock"></i>
                    </div>
                    <h3 class="h5">Access Gatekeeping</h3>
                    <p>Instantly whitelist or blacklist specific IPs and domain roots to strictly prevent hotlinking theft.</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="feature-card security">
                    <div class="icon-box">
                        <i class="fas fa-chart-bar"></i>
                    </div>
                    <h3 class="h5">Google Analytics Logs</h3>
                    <p>Direct tracking interface with GA lets you closely monitor video playback statuses and crashes.</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="feature-card security">
                    <div class="icon-box">
                        <i class="fas fa-id-card"></i>
                    </div>
                    <h3 class="h5">PWA White Labeling</h3>
                    <p>Full support for progressive web application configurations under your unique brand title.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
{% if str_contains(base_url, 'gdplayer.to') or str_contains(base_url, '.test') %}
    <section id="ctaSection" class="py-5" data-nosnippet>
        <div class="cta-banner text-white text-center text-md-left shadow-sm">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h2 class="h3"><i class="fas fa-crown mr-2"></i>Get Full License</h2>
                    <p class="mb-0">Access all features, 45+ hosts, 1 year of updates, and priority support. Starting at $149.</p>
                </div>
                <div class="col-md-4 text-md-right mt-3 mt-md-0">
                    <a href="{{ base_url }}buy" target="_blank" class="btn btn-dark btn-lg font-weight-bold" style="background:#0b0e1a;border:2px solid rgba(255,255,255,0.15);">
                        <i class="fas fa-shopping-cart mr-2"></i> Purchase Now
                    </a>
                </div>
            </div>
        </div>
    </section>
{% endif %}

{% include 'elements/footer.twig' %}
