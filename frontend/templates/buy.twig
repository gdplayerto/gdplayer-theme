                <!-- FAQ 4 (AMBIGUITY FIXED) -->
                <div class="mb-2 border-0 card rounded">
                    <div id="heading4">
                        <button class="text-left shadow-none btn-lg btn btn-primary btn-block collapsed" type="button" data-toggle="collapse" data-target="#collapse4" aria-expanded="false" aria-controls="collapse4">
