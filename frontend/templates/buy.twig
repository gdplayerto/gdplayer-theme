                        </div>
                    </div>
                </div>

                <!-- FAQ 7 -->
                <div class="mb-2 border-0 card rounded">
                    <div id="heading7">
                        <button class="text-left shadow-none btn-lg btn btn-warning btn-block collapsed text-dark" type="button" data-toggle="collapse" data-target="#collapse7" aria-expanded="false" aria-controls="collapse7">
