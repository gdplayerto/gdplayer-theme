                        </div>
                    </div>
                </div>

                <!-- FAQ 3 -->
                <div class="mb-2 border-0 card rounded">
                    <div id="heading3">
                        <button class="text-left shadow-none btn-lg btn btn-success btn-block collapsed" type="button" data-toggle="collapse" data-target="#collapse3" aria-expanded="false" aria-controls="collapse3">
