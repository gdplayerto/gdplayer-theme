                    { icon: 'fas fa-check-circle', label: 'Access to All Additional Premium Hosts' },
                    { icon: 'fas fa-check-circle', label: 'Priority Request for Obscure Platforms' },
                    { icon: 'fas fa-star text-warning', label: 'Best Value for Scaling Networks' },
                    { icon: 'fas fa-check-circle', label: '1st Year Free Updates & Support' },
                    { icon: 'fas fa-times-circle text-danger', label: 'Reselling the script itself is strictly prohibited' }
                ],
                kofi_link: 'https://ko-fi.com/s/d9430b55b2',
                nowpayments_link: 'https://nowpayments.io/payment/?iid=5310556485&source=button'
            } only %}
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            {% include 'elements/pricing-card.twig' with {
                pricing_title: 'Recommended Plugin',
                pricing_badge_style: 'background: linear-gradient(135deg, #e11d48 0%, #9f1239 100%);',
                pricing_tracking_wider: 'Swoole Proxy',
                price_amount: '69',
                price_period: 'Perpetual License · 1 Year Updates',
                short_desc: 'Speed up video delivery without replacing your web server. Video streams are served by a long-running Swoole worker while the rest of the site keeps running on nginx, Apache or LiteSpeed.',
                pricing_features: [
                    { icon: 'fas fa-check-circle', label: 'Long-Running Swoole Worker for Video Streams' },
                    { icon: 'fas fa-check-circle', label: 'Serves HLS Segments, Live Streams and MP4 Files' },
                    { icon: 'fas fa-check-circle', label: 'Site Stays on Your Current Web Server' },
                    { icon: 'fas fa-check-circle', label: 'One-Time Setup: Install the PHP Extension, Start the Worker' },
                    { icon: 'fas fa-check-circle', label: 'Highly Recommended for High Traffic' },
                    { icon: 'fas fa-check-circle', label: '1st Year Free Updates & Support' },
                    { icon: 'fas fa-times-circle text-danger', label: 'Reselling the script itself is strictly prohibited' }
                ],
                pricing_note: '* Subsequent years of updates & support optional at $35/year.',
                pricing_card_style: 'border: 2px solid var(--primary-dark); box-shadow: 0 10px 30px rgba(var(--rgb-color), 0.15) !important;',
                kofi_link: 'https://ko-fi.com/s/b368a8bd99',
                nowpayments_link: 'https://nowpayments.io/payment/?iid=4343044357&source=button'
            } only %}
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            {% include 'elements/pricing-card.twig' with {
                pricing_title: 'High Concurrency',
                pricing_badge_style: 'background: linear-gradient(135deg, #10b981 0%, #047857 100%);',
                pricing_tracking_wider: 'RoadRunner Proxy',
                price_amount: '59',
                price_period: 'Perpetual License · 1 Year Updates',
                short_desc: 'A Go-powered engine that keeps video streaming stable under heavy load. Ideal for clusters and load-balanced setups, without migrating the rest of the site.',
                pricing_features: [
                    { icon: 'fas fa-check-circle', label: 'Go-Powered Worker for Video Streams' },
                    { icon: 'fas fa-check-circle', label: 'Serves HLS Segments, Live Streams and MP4 Files' },
                    { icon: 'fas fa-check-circle', label: 'Site Stays on Your Current Web Server' },
                    { icon: 'fas fa-check-circle', label: 'Automatic Worker Restart if a Process Stops' },
                    { icon: 'fas fa-check-circle', label: '1st Year Free Updates & Support' },
                    { icon: 'fas fa-times-circle text-danger', label: 'Reselling the script itself is strictly prohibited' }
                ],
                pricing_note: '* Subsequent years of updates & support optional at $25/year.',
                kofi_link: 'https://ko-fi.com/s/caf2f6bb1b',
                nowpayments_link: 'https://nowpayments.io/payment/?iid=4753896589&source=button'
            } only %}
        </div>
    </div>
</section>

