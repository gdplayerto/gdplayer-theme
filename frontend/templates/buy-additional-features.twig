{% include 'elements/header.twig' %}

<!-- Pricing/Add-on Section -->
<section id="pricing" class="pricing-section py-5 text-center">
    <h1 class="section-title">Buy GDPlayer <span class="text-gradient">Additional Features</span></h1>
    <p class="section-subtitle">Expand your streaming capabilities with premium add-on hosts and integrations.</p>
    <div class="row justify-content-center form-row text-center">
        <div class="col-12 col-md-6 col-xl-3">
            {% include 'elements/pricing-card.twig' with {
                pricing_title: 'Single Add-on',
                pricing_tracking_wider: 'Single Additional Host',
                pricing_badge_style: 'background: linear-gradient(135deg, #f59e0b 0%, #b45309 100%);',
                price_amount: '10',
                price_period: 'Per Specific Single Host',
                short_desc: 'Perfect if you only need one obscure or premium streaming platform integrated into your current engine.',
                pricing_features: [
                    { icon: 'fas fa-check-circle', label: '1 Premium/Custom Host Integration' },
                    { icon: 'fas fa-check-circle', label: 'Seamless Backend Integration' },
                    { icon: 'fas fa-check-circle', label: '1st Year Free Updates & Support' },
                    { icon: 'fas fa-times-circle text-danger', label: 'Reselling the script itself is strictly prohibited' }
                ],
                kofi_link: 'https://ko-fi.com/s/7ceda84eff',
                nowpayments_link: ''
            } only %}
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            {% include 'elements/pricing-card.twig' with {
                pricing_title: 'Full Add-ons Bundle',
                pricing_tracking_wider: 'All Premium Hosts',
                price_amount: '50',
                price_period: 'All Additional Premium Hosts',
                short_desc: 'Unlock every single premium and obscure streaming host supported by the GDPlayer ecosystem at once.',
