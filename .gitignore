/*/
!/backend
!/docs/
!/frontend
!/src
!/tests
/logs/*.log

# Folder logs tooling tetap ada di repo (phpstan/phpcs menulis ke sini); isinya diabaikan.
!/logs/
!/logs/.gitkeep
/coverage-clover.xml
/.scannerwork/

# Konfigurasi semgrep harus ikut repo meski /*/ mengabaikan semua direktori.
!/.semgrep/
!/.semgrep/**

# Skrip gate (superglobal/exit) harus ikut repo meski /*/ mengabaikan semua direktori.
!/scripts/
!/scripts/**

# artefak cache tool (dihapus, jangan masuk git)
.phpunit.cache/
tests/.sandbox/
